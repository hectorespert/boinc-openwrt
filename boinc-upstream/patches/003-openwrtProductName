+
+// OpenWrt writes the device model (from device tree, DMI, etc.)
+// to /tmp/sysinfo/model at boot; LuCI shows it as "Model".
+// If present, prefer it over the "Hardware" line of /proc/cpuinfo.
+//
+static void get_openwrt_model(HOST_INFO& host) {
+    char buf[256];
+    FILE* f = fopen("/tmp/sysinfo/model", "r");
+    if (!f) return;
+    if (fgets(buf, sizeof(buf), f)) {
+        strip_whitespace(buf);
+        if (strlen(buf)) {
+            safe_strcpy(host.product_name, buf);
+        }
+    }
+    fclose(f);
+}
