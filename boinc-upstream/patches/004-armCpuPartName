+#if defined(__aarch64__) || defined(__arm__)
+// arm64 kernels give no "model name" in /proc/cpuinfo,
+// only the MIDR fields "CPU implementer" and "CPU part".
+// Map them to a core name.
+// PoC: only the cores of the test devices are listed.
+//
+struct ARM_CPU_PART {
+    unsigned long implementer;
+    unsigned long part;
+    const char* name;
+};
+
+static const ARM_CPU_PART arm_cpu_parts[] = {
+    {0x41, 0xd03, "Cortex-A53"},
+};
+
+static const char* arm_cpu_part_name(const char* implementer, const char* part) {
+    if (!strlen(implementer) || !strlen(part)) return NULL;
+    unsigned long impl = strtoul(implementer, NULL, 0);
+    unsigned long p = strtoul(part, NULL, 0);
+    for (const ARM_CPU_PART& cp : arm_cpu_parts) {
+        if (cp.implementer == impl && cp.part == p) {
+            return cp.name;
+        }
+    }
+    return NULL;
+}
+#endif
