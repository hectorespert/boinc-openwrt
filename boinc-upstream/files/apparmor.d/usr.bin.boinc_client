# AppArmor profile for the BOINC client (boinc_client)
# Installed to /etc/apparmor.d/usr.bin.boinc_client

#include <tunables/global>

/usr/bin/boinc_client {
  #include <abstractions/base>
  #include <abstractions/nameservice>
  #include <abstractions/openssl>
  #include <abstractions/ssl_certs>

  # Capabilities required by boinc_client
  capability setuid,
  capability setgid,
  capability sys_resource,

  # Network access for project servers (upload/download work units and results)
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,

  # Own executable
  /usr/bin/boinc_client mr,

  # Shared libraries (mmap+read only; no arbitrary binary execution)
  /usr/lib/                r,
  /usr/lib/lib*.so*       mr,

  # BOINC data directory (read-write; work units and results live here)
  # Link creation (l) is needed for slot-directory symlink management.
  /opt/boinc/              rw,
  /opt/boinc/**           rwk,
  /opt/boinc/slots/**     rwkl,

  # Preset / shared configuration files (read-only)
  /usr/share/boinc/        r,
  /usr/share/boinc/**      r,

  # PID file written by procd / boinc_client itself
  /var/run/boinc_client.pid rw,

  # System information read by the client to report host capabilities
  /proc/cpuinfo            r,
  /proc/meminfo            r,
  /proc/stat               r,
  /proc/uptime             r,
  /proc/sys/kernel/osrelease r,
  /sys/devices/system/cpu/ r,
  /sys/devices/system/cpu/** r,

  # Timezone and locale
  /etc/TZ                  r,
  /etc/localtime           r,
  /usr/share/zoneinfo/**   r,

  # SSL certificate bundle used by libcurl
  /etc/ssl/certs/          r,
  /etc/ssl/certs/**        r,
  /etc/ssl/certs/ca-certificates.crt r,

  # OS/distro identification
  /etc/os-release          r,
  /usr/lib/os-release      r,

  # Temporary files used during computation (restricted to BOINC-owned prefix)
  /tmp/boinc*/            rwk,
  /tmp/boinc*/**         rwk,

  # Deny write access to sensitive system files
  deny /etc/passwd         w,
  deny /etc/shadow        rw,
  deny /root/**           rwklx,
}
